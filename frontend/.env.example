# MentorOS web app — public, build-time values only (never put secrets here).
# On Vercel the Supabase integration provides NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY, which the app reads as well.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Leave empty when the API is served from the same origin under /api (Vercel).
VITE_API_BASE_URL=
VITE_ENABLE_GOOGLE_AUTH=false
