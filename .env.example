# ─────────────────────────────────────────────────────────────────────────────
# MentorOS — environment configuration (copy to `.env` for local development)
#
# One file configures the API (FastAPI). The SPA reads only VITE_* and
# NEXT_PUBLIC_* values (see frontend/.env.example). Never commit real values.
# In production these live in Vercel → Project → Settings → Environment
# Variables; the Supabase-via-Vercel integration injects the SUPABASE_* and
# POSTGRES_* variables automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development                 # development | test | production
APP_BASE_URL=http://localhost:5173      # used in notification links / emails
SCORING_PERIOD=2026-ODD                 # current academic term code
LOG_LEVEL=INFO

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Local: a plain Postgres. Hosted: POSTGRES_URL (pooled, transaction mode) and
# POSTGRES_URL_NON_POOLING (used for migrations) come from the integration.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mentoros
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# ── Supabase Auth & Storage ──────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=              # server-only: admin user creation + storage
SUPABASE_JWT_SECRET=                    # HS256 verification (JWKS also supported)
STORAGE_AVATAR_BUCKET=avatars
STORAGE_RESUME_BUCKET=resumes

# ── Access policy ────────────────────────────────────────────────────────────
# Comma-separated institutional domains. Empty = any domain, but accounts are
# only ever created by admins (no self-registration).
ALLOWED_EMAIL_DOMAINS=
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Operations ───────────────────────────────────────────────────────────────
OPS_TOKEN=                              # protects /api/v1/ops/bootstrap/* (unset = disabled)
CRON_SECRET=                            # Vercel Cron bearer for /api/v1/ops/cron/nightly
DEMO_ACCOUNT_PASSWORD=                  # password for the four synthetic demo logins
DEMO_EMAIL_DOMAIN=mentoros.demo

# ── Optional integrations (all degrade gracefully when unset) ───────────────
GOOGLE_OAUTH_ENABLED=false              # enable the Google provider in Supabase first

LLM_PROVIDER=auto                       # auto | anthropic | openai | gemini | ollama | none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=                        # e.g. http://localhost:11434 (self-hosted)
OLLAMA_MODEL=gemma3:4b

EMAIL_PROVIDER=auto                     # auto | resend | smtp | none
EMAIL_FROM=MentorOS <no-reply@example.edu>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

NOTIFY_WEBHOOK_URL=                     # Slack/Discord-compatible incoming webhook

# Institution system connectors — GET {URL}/health and {URL}/mentoros/{dataset}
ERP_API_URL=
ERP_API_KEY=
LMS_API_URL=
LMS_API_KEY=
ATTENDANCE_API_URL=
ATTENDANCE_API_KEY=
PLACEMENT_API_URL=
PLACEMENT_API_KEY=

# Optional self-hosted worker (Vercel Cron covers the nightly job in production)
CELERY_BROKER_URL=
