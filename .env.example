# MentorOS API Configuration Example
# Copy this file to .env and configure variables for local development

# Database configuration,
# PostgreSQL example: postgresql://username:password@localhost:5432/mentoros
# SQLite fallback example: sqlite:///./sql_app.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mentoros

# Security Settings
# Generate a secure key in production (e.g. openssl rand -hex 32)
SECRET_KEY=supersecretkeychangeinproduction
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Optional Server Details
PROJECT_NAME="MentorOS API"
API_V1_STR=/api/v1
